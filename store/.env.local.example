# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Resend (for sending waitlist emails)
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_your_api_key_here

# Custom from address (requires verified domain in Resend)
# Until verified, use: Elanora <onboarding@resend.dev>
RESEND_FROM_EMAIL=Elanora <hello@yourdomain.com>
