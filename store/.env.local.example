# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Gmail (for sending waitlist emails)
# Use your Gmail address and an App Password (NOT your regular password)
# Create an App Password: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Public site address, used for Stripe return links and product images (e.g. https://elanora.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" after activating Stripe Tax in the Dashboard (Settings → Tax)
STRIPE_AUTOMATIC_TAX=false

# Admin dashboard (/admin) password
ADMIN_PASSWORD=choose-a-long-password
# Analytics database — added automatically when you create a Neon database in Vercel → Storage
DATABASE_URL=

# Stripe webhook signing secret (whsec_...), from Stripe → Developers → Webhooks.
# Endpoint: https://elanorajewelry.com/api/stripe/webhook — events: checkout.session.completed,
# checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=
